msgstr "No tienes acceso al formulario de esta entrada."

#: app/Modules/MCP/Support/FormAccess.php:74
msgid "No entry found for the given entry_id."
msgstr "No se encontró ninguna entrada para el entry_id proporcionado."

#: app/Modules/MCP/Support/FormAccess.php:70
msgid "entry_id is required."
msgstr "entry_id es obligatorio."

#: app/Modules/MCP/Support/FormAccess.php:50
msgid "No form found for the given form_id."
msgstr "No se encontró ningún formulario para el form_id proporcionado."

#: app/Modules/MCP/Support/FormAccess.php:46
msgid "You do not have access to this form."
msgstr "No tienes acceso a este formulario."

#: app/Modules/MCP/Support/FormAccess.php:43
msgid "form_id is required."
msgstr "form_id es obligatorio."

#: app/Modules/MCP/MCPInit.php:250
msgid "FluentForm MCP is enabled but no MCP adapter was found. Install FluentHub (recommended) or the MCP Adapter plugin, on WordPress 6.9+."
