#: app/Modules/MCP/Tools/StylingTools.php:197
msgid "Saving custom CSS requires the unfiltered_html capability."
msgstr "Guardar CSS personalizado requiere la capacidad unfiltered_html."

#: app/Modules/MCP/Tools/StylingTools.php:171
msgid "Provide at least one of: styler_theme, css."
msgstr "Proporciona al menos uno de: styler_theme, css."

#. translators: %s: form title
#: app/Modules/MCP/Tools/StylingTools.php:147
msgid "Styling for \"%s\" loaded."
msgstr "Estilos de «%s» cargados."

#: app/Modules/MCP/Tools/StylingTools.php:50
msgid "Update a form's styling. styler_theme (preset id) is always writable. Custom css is written only if you hold the unfiltered_html capability; otherwise the call returns unfiltered_html_required and changes nothing. Pass only the keys you want to change. Call once with dry_run:true to preview the before/after and get a confirm_token, then call again with the same values plus confirm_token to execute. Requires form_id. (Structured styler_styles are read-only via get-form-styling; edit them in the form styler UI. Custom JS is not editable through MCP.)"
msgstr "Actualiza los estilos de un formulario. styler_theme (ID del ajuste predefinido) siempre se puede escribir. El CSS personalizado solo se escribe si tienes la capacidad unfiltered_html; de lo contrario, la llamada devuelve unfiltered_html_required y no cambia nada. Pasa solo las claves que quieras cambiar. Llama una vez con dry_run:true para previsualizar el antes/después y obtener un confirm_token, luego llama de nuevo con los mismos valores más confirm_token para ejecutar. Requiere form_id. (Los styler_styles estructurados son de solo lectura a través de get-form-styling; edítalos en la interfaz de estilos del formulario. El JS personalizado no se puede editar a través de MCP.)"

#: app/Modules/MCP/Tools/StylingTools.php:48
msgid "Update Form Styling"
msgstr "Actualizar estilos del formulario"

#: app/Modules/MCP/Tools/StylingTools.php:34
msgid "Read a form's styling: theme preset (styler_theme), structured styles (styler_styles), and any custom CSS. Requires form_id."
msgstr "Lee los estilos de un formulario: ajuste predefinido del tema (styler_theme), estilos estructurados (styler_styles) y cualquier CSS personalizado. Requiere form_id."

#: app/Modules/MCP/Tools/StylingTools.php:32
msgid "Get Form Styling"
msgstr "Obtener estilos del formulario"

#. translators: %d: maximum allowed days in the date window
#: app/Modules/MCP/Tools/ReportTools.php:524
msgid "The date window may span at most %d days. Narrow date_from/date_to and call again."
msgstr "La ventana de fechas puede abarcar como máximo %d días. Reduce date_from/date_to y vuelve a llamar."

#: app/Modules/MCP/Tools/ReportTools.php:514
#: app/Modules/MCP/Tools/SubmissionTools.php:174
msgid "date_from must be on or before date_to."
msgstr "date_from debe ser anterior o igual a date_to."

#: app/Modules/MCP/Tools/ReportTools.php:510
msgid "date_from must be a valid date in YYYY-MM-DD format."
msgstr "date_from debe ser una fecha válida en formato YYYY-MM-DD."

#: app/Modules/MCP/Tools/ReportTools.php:505
msgid "date_to must be a valid date in YYYY-MM-DD format."
msgstr "date_to debe ser una fecha válida en formato YYYY-MM-DD."

#. translators: %d: total entries
#: app/Modules/MCP/Tools/ReportTools.php:433
msgid "%d entries in this window."
msgstr "%d entradas en esta ventana."

#. translators: 1: total entries, 2: top form title, 3: peak weekday, 4: peak
